# --- Python ---
__pycache__/
*.py[oc]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Node / Next.js ---
node_modules/
.next/

# --- Secrets (keep the example template) ---
.env
.env.*
!.env.example

# --- Data: raw downloads, licensed LCD/article content, generated PDFs ---
/data/

# --- Eval runs: ignore everything except summary files ---
# Ignore all files under runs/, but re-include directories so git can look
# inside them, then re-include summaries. (Git can't re-include a file whose
# parent directory is excluded, hence the middle line.)
evals/runs/**
!evals/runs/**/
!evals/runs/**/summary*

# --- OS / editors ---
.DS_Store
.idea/
.vscode/
